{
  // Отдельный воркер страницы Quantum Rating.
  // Собирается из папки quantum/ репозитория vitaly1970/HVMI —
  // в настройках сборки Cloudflare указать root directory: quantum
  "name": "hvmi-quantum",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",

  // Статика: сама страница. Запрос сначала ищется среди файлов,
  // и только потом попадает в воркер — поэтому маршруты /api/* его достигают.
  "assets": {
    "directory": "./public"
  },

  "observability": {
    "enabled": true
  }
}
